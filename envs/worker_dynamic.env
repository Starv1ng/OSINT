# envs/worker_dynamic.env

# Configuración de búsqueda dinámica

# Modo de ejecución: conservative, normal, aggressive, custom
EXECUTION_MODE=normal

# Número máximo de iteraciones (si EXECUTION_MODE=custom)
MAX_ITERATIONS=5

# Umbral de relevancia (0-1) para nuevos indicadores
RELEVANCE_THRESHOLD=0.5

# Número de workers paralelos
MAX_WORKERS=3

# Base de datos
DATABASE_URL=postgresql://dev:devpass@postgres:5432/osint

# Redis
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Logging
LOG_LEVEL=INFO

# Timeouts
MODULE_TIMEOUT=30
TOTAL_SEARCH_TIMEOUT=300
